.DS_Store
.env
node_modules/

# Design export reference (the SaaS design source-of-truth every prompt points at).
# The README + per-page HTML files ARE committed; only the 11.4 MB single-file
# bundle is excluded — it's a duplicate concatenation of the per-page files.
design-export/stennisfy-all-in-one.html

# Local-only runtime artifacts — not part of the project source or CI seed data
.claude/*
!.claude/rules/
!.claude/skills/
*.log
*.bak
# TEN-270: the Kibl card job's local snapshots (restored/saved via actions/cache).
.cache/

# Point-by-point shards + their availability index: pure derived output, rebuilt
# from point-by-point-cache.json (the tracked seed) on every pipeline run and
# published straight to _site. One file per match, so committing them would add
# hundreds of churning blobs that nothing reads from git.
pbp/
pbp-index.json
setstats/
setstats-index.json

# Recent-form shards + their availability index: same story — one file per
# player, rebuilt by bsp-pipeline.js on every run from the fixture window it
# already fetches, and served straight from _site.
form/
form-index.json
# TEN-263 match-close shards: built every pipeline run from odds-archive/ (never committed).
match-closes/
match-closes-index.json
# TEN-263 D-12: rebuilt every pipeline run by tools/build-elo-key-conflicts.mjs
elo-key-conflicts.json

# Odds-movement shards + their availability index: one file per match, split out
# of matches.json by bsp-pipeline.js on every run from the timelines the capturer
# committed there. Derived output — the tracked source of truth stays inline in
# matches.json, where refresh-odds-history.py writes it.
odds/
odds-index.json

# Career-record drill-down shards + their index: one file per player, rebuilt
# every run from the all-tier fixture window plus the TML archive. ~10 MB across
# ~480 players — derived output that would churn the whole set on every run.
career-history/
career-history-index.json

# TEN-207 whole-career tournament-history shards + their index: one file per
# player, split out of player-profiles.json (it was 50% of that file). Rebuilt
# every run from player-tournament-history.json, exactly like career-history/ —
# derived output that would churn the whole set on every run.
tournament-history/
tournament-history-index.json
mcp-cache/
tml-cache/
chall-cache/

# Tennis Edge Model output: the h2h-model engine result + pre-baked AI summary,
# one entry per match. Pure pipeline-derived output — bsp-pipeline.js regenerates
# it every run and publishes it straight to _site. Must never be committed: it
# would churn on every run, and a keyless local build carries no AI summaries.
model-output.json

# News feed + tournament entries: build-news-feed.js / build-tournament-entries.js
# pull api-tennis on every pipeline run and publish straight to _site. Like
# model-output.json they churn every run and need the API key to build, so they
# are never committed.
news-feed.json
tournament-entries.json
_render-page.html
_render-reports.html

apitennis-styles-cache/
apitennis-holdbreak-cache/
styles-debug-all.json

# TEN-151 Trading Report shard (lazy, rebuilt each run — publish wiring pending size gate)
trading-splits/
trading-splits-index.json
# TEN-151 MATCHES divergence report — build artifact, reviewed off-line, never client-shipped
trading-splits-divergence.json
.first-appearance-billed-strike
# TEN-179 item 3 — the metered spend guard's in-job marker. UNTRACKED ON PURPOSE:
# ci-commit-push.sh's REDO path does `git reset --hard`, which leaves untracked files
# alone, so "this hour is already paid for" survives a push race. That is the whole
# mechanism; committing it would defeat it.
.metered-spend-marker
.design-ten206/

# TEN-206 Q2(d) ch-1, 2026-09-16: the profile caches are runtime artifacts. The
# DURABLE copy is the gzipped .gz beside them, refreshed once a UTC day by the
# pipeline; these plain files are what the Actions cache restores and what
# bsp-pipeline.js reads/writes. Tracking them uncompressed is how the 57.4 MB
# July-2026 v7 copy sat in the repo for 56 days as the silent cache-miss floor.
player-profiles-cache.json
player-tournament-history.json

# TEN-206 founder ruling 2026-09-18 (Q2): historical-match-stats.json joins them.
# It was tracked UNCOMPRESSED and never committed back, so the tracked copy was a
# fossil floor — 1,082 entries against the 2,002 deployed — and an Actions-cache
# eviction at the repo's 10 GiB ceiling silently halved the Player Profile match
# sheet's box-score coverage. The durable copy is now
# historical-match-stats.json.gz, refreshed by tools/match-stats-store.js after
# the deploy has published. Founder ruling 2026-09-18 (Q1): that floor is PLAIN
# MINIFIED JSON at historical-match-stats.floor.json — 5.3 MB/yr of history flat,
# against gzip's 8.1–88.9 depending on whether the day's edits were a pure append.
# The floor is TRACKED; only this working path, which the Actions cache owns and
# overwrites, is ignored.
historical-match-stats.json

# TEN-206 Q2 third clause: the per-event coverage index behind the match sheet's
# whole-event note. A pure derivative — rebuilt from the match-stat store and the
# deployed profile store on every run and copied into _site, never committed.
match-stat-event-coverage.json

# TEN-206 player search / profile split — both rebuilt from get_standings and the
# profile cache on every run, and copied into _site by the deploy step. Runtime
# artifacts like career-history/ above, never committed.
profiles/
player-index.json

# deployed-store cache (tools/deployed-store.js) — snapshots of the LIVE stores
.deployed-cache/

# ── SYMLINK FORMS, NOT JUST DIRECTORY FORMS ─────────────────────────────────
# `node_modules/` and `.deployed-cache/` above carry a TRAILING SLASH, which
# matches a directory and NOT a symlink. Both paths were committed as dangling
# symlinks (mode 120000) by a `git add -A` run in a worktree where they had been
# linked to another checkout for convenience. On a clean CI checkout they point
# at a path that does not exist:
#   node_modules      08e61cd9
#   .deployed-cache   584a8045  -> broke "Assemble site" with ENOENT on mkdir
# The slashless forms below close that. Locked by tools/test-no-broken-symlinks.js.
node_modules
.deployed-cache

# TEN-260: built every pipeline run by build-lines-field.js from the (gitignored)
# career-history store, like career-history/ itself. Never committed.
lines-field.json
