rules_version = '2';

// BSP Consult · Tennis Edge — Firestore production security rules
// Project: tennis-edge-75cd9
//
// Replaces the default test-mode rules (open read/write). Deploy from the
// Firebase console (Firestore Database → Rules → Publish) or via the CLI
// (`firebase deploy --only firestore:rules`).
//
// Design: a signed-in user can only ever touch their OWN data. Analytics /
// affiliate rows are create-only from the client and are never client-readable
// (the future admin analytics view reads them server-side, which bypasses these
// rules). Everything not matched below is denied by default.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- User profiles ------------------------------------------------------
    // A user may read and write ONLY their own document. No user can read or
    // write another user's data. Unauthenticated requests match nothing here,
    // so they get zero access.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      // Picks Task 2 (founder 2026-10-27: "Pro by plan"): `plan` is set ONLY by the Whop webhook (Admin SDK, which
      // bypasses these rules). A client may create its own document with plan 'free' (sign-up) and may never change
      // `plan` afterwards — otherwise any member could make themselves Pro from the browser console.
      allow create: if request.auth != null && request.auth.uid == uid
                    && (!('plan' in request.resource.data) || request.resource.data.plan == 'free');
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan']);
    }

    // ---- Affiliate bookmaker-click events (batch item 7) --------------------
    // A signed-in user may create their own click rows (must stamp their own
    // uid). Clients can never read, edit, or delete click data.
    match /affiliate_clicks/{clickId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ---- Behaviour analytics events (batch item 8, if kept in Firestore) ----
    // Same shape as affiliate clicks: own-create only, no client reads.
    match /analytics_events/{eventId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ---- Admin ledger (TEN-8, founder-only) ---------------------------------
    // The admin dashboard's performance ledger is mirrored into `admin/log` by
    // the pipeline (via the Admin SDK / service account, which BYPASSES these
    // rules — hence writes are denied to all normal clients below). Only the
    // founder account may READ it, so the ledger is genuinely private even
    // though admin.html is a static, publicly-fetchable page.
    //
    // >>> FOUNDER ACTION REQUIRED <<<  Fill in the SAME identity you put in
    // admin-config.js. Prefer uid(s); email(s) are matched case-sensitively by
    // Firestore so use the exact lowercase address. Delete the branch you don't
    // use. Until at least one real value is present, this read denies everyone.
    // Kept exactly as the LIVE rules have it (read 2026-10-28 from release fe571fec…, updated 2026-07-28): the founder's
    // uid only, and the admin documents (any depth) readable and writable by the admin.
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['dqniZkontSPLBwseOTBzmfCBUQG3'];
    }
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // ---- BSP Consult Intel (TEN-8 news-updates) -----------------------------
    // Founder-authored injury / insider notes shown on the News page above the
    // automated articles. Unlike the admin ledger above (written server-side by
    // CI, so all client writes are denied), these notes are written from the
    // BROWSER by the founder while signed in — so the client write must be
    // allowed, but ONLY for the admin allowlist. Any signed-in member may read
    // them (the News page is behind the member auth gate).
    // ---- Picks (Task 2, founder 2026-10-27: real roles — admin flag on the founder's account, Pro by plan) ----
    // picks/{id}        the full pick. Settled picks (won · lost · void) are readable by any signed-in member; today's
    //                   posted / live picks only by Pro members and the admin; drafts only by the admin.
    // picks_public/{id} the teaser of the same pick: only what a non-Pro member may see on a blurred card (type,
    //                   tournament, round, time, posted time, stake, state). Any signed-in member may read it.
    // Only the admin writes, and only what the founder types: the pick, the stake, the note (+ the identity of the match
    // and the price the drawer read). Open / Now / Close / result / status after posting / CLV / P/L are written by the
    // pipeline with the Admin SDK (tools/picks-updater.mjs), which bypasses these rules — a client can never write them.
    // Research and development (founder 2026-10-30): the admin may change a posted pick's note and stake, void it with a
    // reason, or delete it (with its teaser) at any time — no 10-minute window, no freeze. The note has no length cap
    // (Firestore's own 1 MiB document limit is the only bound). Server-written fields stay server-only.
    function signedIn() { return request.auth != null; }
    function isPro() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan == 'pro';
    }
    function pickClientKeys() {
      return ['kind', 'event', 'market_text', 'settles_at', 'date', 'tournament', 'round', 'scheduled_at', 'surface',
              'match_id', 'player_a', 'player_b', 'selection', 'market', 'line', 'book', 'price_source', 'posted_price',
              'posted_at', 'stake', 'note', 'model_pct', 'status', 'void_reason', 'created_by', 'edited_at'];
    }
    function stakeOk(d) { return d.stake is number && d.stake >= 0.1 && d.stake <= 10; }
    function noteOk(d) { return d.note is string; }
    function newPickOk(d) {
      return d.keys().hasOnly(pickClientKeys())
        && d.status in ['posted', 'draft'] && d.kind in ['match', 'outright']
        && d.posted_price is number && d.posted_price > 1 && stakeOk(d) && noteOk(d)
        && d.created_by == request.auth.uid
        && (d.status == 'draft' || d.posted_at == request.time);
    }
    function postedPick() { return resource.data.status in ['posted', 'live', 'won', 'lost', 'void']; }
    function editOk() {
      let ch = request.resource.data.diff(resource.data).affectedKeys();
      return (resource.data.status == 'draft' && request.resource.data.keys().hasOnly(pickClientKeys())
                && request.resource.data.status in ['draft', 'posted'] && stakeOk(request.resource.data) && noteOk(request.resource.data)
                && (request.resource.data.status == 'draft'
                    || request.resource.data.posted_at == request.time))
        || (postedPick() && ch.hasOnly(['note', 'stake', 'edited_at']) && stakeOk(request.resource.data) && noteOk(request.resource.data)
                && request.resource.data.edited_at == request.time)
        || (postedPick() && resource.data.status != 'void' && ch.hasOnly(['status', 'void_reason', 'edited_at']) && request.resource.data.status == 'void'
                && request.resource.data.void_reason is string && request.resource.data.void_reason.size() > 0
                && request.resource.data.edited_at == request.time);
    }
    match /picks/{id} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.status in ['won', 'lost', 'void'])
                  || (resource.data.status in ['posted', 'live'] && isPro());
      allow create: if isAdmin() && newPickOk(request.resource.data);
      allow update: if isAdmin() && editOk();
      allow delete: if isAdmin();
    }
    function teaserKeys() {
      return ['kind', 'event', 'date', 'tournament', 'round', 'scheduled_at', 'surface', 'market', 'posted_at', 'stake', 'status'];
    }
    match /picks_public/{id} {
      allow read: if signedIn();   // a teaser is written only when a pick is posted, never for a draft
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(teaserKeys());
      allow delete: if isAdmin();
    }

    // as live: any depth under intel_notes
    match /intel_notes/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---- Default deny -------------------------------------------------------
    // Any path not matched above is fully locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
