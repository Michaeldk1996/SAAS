   "timestampKind": "observed (the outlet's own publication time)",
   "category": "Interviews",
   "context": null,
   "eventKey": null,
   "won": null,
   "text": "It would be incredible to win the Davis Cup with GB and these guys. We're going to push hard to achieve that. It's the final tournament of the year so we're going to give everything and put it all out there.",
   "originalText": null,
   "language": "en",
   "translated": false,
   "translationModel": null,
   "sourceName": "LTA",
