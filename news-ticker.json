   "timestampKind": "observed (the outlet's own publication time)",
   "category": "Interviews",
   "context": null,
   "eventKey": null,
   "won": null,
   "text": "When the call-ups were announced, I knew I had to be ready. I continued training and playing because the captain had told us all that the official selections would come later. So I kept preparing as I had in previous years, to be ready to join the team,",
   "originalText": null,
   "language": "en",
   "translated": false,
   "translationModel": null,
   "sourceName": "TennisUpToDate",
