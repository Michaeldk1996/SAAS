   "verbatimCheckedOn": "the original-language text of the fetched page",
   "sourceHash": "b6beb88fd53dd8b4",
   "publishedAt": "2026-11-24T15:32:58.361Z",
   "file": "news-ticker/3120-2026.json"
  },
  {
   "id": "quote-e8d792a0345fc9",
   "type": "quote",
   "playerId": "2959",
   "opponentId": null,
   "player": "J. Lehecka",
   "opponent": null,
   "tournament": "Davis Cup - World Group",
   "tournamentKey": "3120",
   "season": "2026",
   "round": null,
   "timestamp": "2026-11-24T03:30:00.000Z",
   "timestampKind": "observed (the outlet's own publication time)",
   "category": "Interviews",
   "context": null,
   "eventKey": null,
   "won": null,
   "text": "I think it can be a great advantage for us. There is nobody in the tennis world who knows Felix better than Fred. He grew up with him, developed him as a tennis player and took him into the world's top five,",
   "originalText": null,
   "language": "en",
   "translated": false,
   "translationModel": null,
   "sourceName": "TennisUpToDate",
   "sourceUrl": "https://tennisuptodate.com/atp/felix-auger-aliassimes-former-coach-could-help-plot-his-davis-cup-downfall-and-tomas-berdych-knows-it",
   "verbatimCheck": "passed",
   "verbatimCheckedOn": "the original-language text of the fetched page",
   "sourceHash": "e955d6927599eb41",
   "publishedAt": "2026-11-24T15:32:58.361Z",
   "file": "news-ticker/3120-2026.json"
  },
  {
   "id": "quote-199f3a50138064",
   "type": "quote",
   "playerId": "2844",
