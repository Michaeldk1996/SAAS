   "publishedAt": "2026-11-24T09:26:58.128Z",
   "file": "news-ticker/tour-2026.json"
  },
  {
   "id": "quote-15de5c8e4ebcd7",
   "type": "quote",
   "playerId": "8174",
   "opponentId": null,
   "player": "A. Fery",
   "opponent": null,
   "tournament": "ATP Tour",
   "tournamentKey": "tour",
