   "sourceHash": "4eaea2160388576f",
   "publishedAt": "2026-11-24T08:45:28.733Z",
   "file": "news-ticker/tour-2026.json"
  },
  {
   "id": "quote-9019f1f24a242f",
   "type": "quote",
   "playerId": "8174",
   "opponentId": null,
   "player": "A. Fery",
   "opponent": null,
   "tournament": "ATP Tour",
   "tournamentKey": "tour",
