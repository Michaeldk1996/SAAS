   "timestampKind": "observed (the outlet's own publication time)",
   "category": "Interviews",
   "context": null,
   "eventKey": null,
   "won": null,
   "text": "For me, it is always a great honour and pleasure. Since I was a child, representing the national team and playing in the Davis Cup has been the biggest dream a player can have. I am happy to be here for another year.",
   "originalText": null,
   "language": "en",
   "translated": false,
   "translationModel": null,
   "sourceName": "TennisUpToDate",
