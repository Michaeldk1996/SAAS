   "timestampKind": "observed (the outlet's own publication time)",
   "category": "Interviews",
   "context": null,
   "eventKey": null,
   "won": null,
   "text": "I think it's really important to have the same guys,",
   "originalText": null,
   "language": "en",
   "translated": false,
   "translationModel": null,
   "sourceName": "LTA",
   "sourceUrl": "https://www.lta.org.uk/fan-zone/davis-cup/news/arthur-fery-ready-to-give-everything-for-the-brits-in-bologna",
