   "publishedAt": "2026-11-24T08:45:28.733Z",
   "file": "news-ticker/tour-2026.json"
  },
  {
   "id": "quote-23b0add5e54b6d",
   "type": "quote",
   "playerId": "2959",
   "opponentId": null,
   "player": "J. Lehecka",
   "opponent": null,
   "tournament": "Davis Cup - World Group",
   "tournamentKey": "3120",
   "season": "2026",
   "round": null,
   "timestamp": "2026-11-24T03:30:00.000Z",
   "timestampKind": "observed (the outlet's own publication time)",
   "category": "Interviews",
   "context": null,
   "eventKey": null,
   "won": null,
   "text": "Felix is a great guy. He was a superstar from childhood, the kind of player everyone said would reach the top one day. And he did it. His path to success was a little different; he got there a bit earlier than me,",
   "originalText": null,
   "language": "en",
   "translated": false,
   "translationModel": null,
   "sourceName": "TennisUpToDate",
   "sourceUrl": "https://tennisuptodate.com/atp/felix-auger-aliassimes-former-coach-could-help-plot-his-davis-cup-downfall-and-tomas-berdych-knows-it",
