   "verbatimCheck": "passed",
   "verbatimCheckedOn": "the original-language text of the fetched page",
   "sourceHash": "108c530966fc714c",
   "publishedAt": "2026-11-24T02:32:04.524Z",
   "file": "news-ticker/tour-2026.json"
  },
  {
   "id": "quote-2a9ed9472b6c86",
   "type": "quote",
   "playerId": "2844",
   "opponentId": null,
   "player": "M. Berrettini",
   "opponent": null,
   "tournament": "ATP Tour",
   "tournamentKey": "tour",
