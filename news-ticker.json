   "category": "Interviews",
   "context": null,
   "eventKey": null,
   "won": null,
   "text": "There was a bit of worry about what the external world would feel and think, but everyone closest to me at the time gave me the confidence to do it and I'm glad that I did,",
   "originalText": null,
   "language": "en",
   "translated": false,
   "translationModel": null,
