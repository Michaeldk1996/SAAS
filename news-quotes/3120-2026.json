   "blocks": [
    {
     "label": "on Jannik Sinner's recovery from knee surgery",
     "text": "Even though, of course, he's one of my biggest competitors, one of the most difficult players for me to play, I still wish for him to come back to the tour because I've been there, I know what injury feels like, and I don't wish injury upon anyone. He's mentally strong. We know that he's mentally strong. I hope that he takes every step seriously and that in three, four months he can be back to 100 per cent and be back playing.",
     "from": [
      "quote-bd4eee4e495eae",
      "quote-459f81dcb3cf4b"
     ]
    }
